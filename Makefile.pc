# Native build of the game's own code. Completely separate from the matching
# N64 build -- it reads the same sources but writes only under build/pc, and
# nothing here can change build/kirby.us.z64.
#
# The point of this target is measurement, not a playable binary yet. It
# compiles every C file the decompilation has produced, plus the data listings
# translated to C, and reports exactly which symbols are still missing. That
# number IS the remaining porting work, and it moves every time a function is
# matched.
#
#   make -f Makefile.pc           # everything: compile, translate, link
#   make -f Makefile.pc gap       # what is still undefined, by category
#   make -f Makefile.pc objs      # just compile everything
#   make -f Makefile.pc link      # link, or name what stops the link
#
# THE DEFAULT TARGET LINKS NOW. It used to be `all: objs`, which compiled and
# stopped, because the link needed tools/pc/link.sh and that script fills
# every gap with a weak abort-on-call stub. A stub layer cannot be the build:
# it would let a function that was never decompiled pass for ported, which the
# project's governing rule forbids, and a stub that returns zero produces a
# binary that is wrong rather than one that will not link.
#
# tools/pc/link.py is the honest version. It stubs nothing, links what exists,
# and if the link cannot close it says which symbols are missing and which
# category they are in -- reusing tools/pc/gap.py's classification so the two
# can never disagree. It EXITS 0 when the only unresolved symbols are game
# functions the decompilation has not produced yet, because that is this
# project's normal state and not a build failure, and EXITS 1 for anything
# else, which is a real regression in the platform layer or the data
# translation. So a green `make -f Makefile.pc` means "the port owes nothing";
# a red one means something here broke.
#
# THE BUILD IS LP64 (-m64 -DPORT). It was -m32 while the port had no renderer,
# because at -m64 three files failed to compile and 32-bit kept every
# pointer-bearing data table the same shape as the N64's. Both reasons are
# gone:
#
#   * the compile failures were one typedef. include/PR/ultratypes.h widens
#     uintptr_t under PORT, which fixes rdp_reset.c and ovl4_1.c (gbi.h stores
#     a uintptr_t per display-list word and was always 64-bit-ready), and
#     src/main/fault.c has a PORT branch for the (va_list) cast. Nothing the
#     N64 build compiles changes -- PORT is defined only here.
#   * libultraship is a 64-bit library. -m32 and libultraship are mutually
#     exclusive, so the renderer decision forces the pointer width.
#
# PORT is therefore the flag that means "this is the native port", and it is
# defined in exactly one place: here.

PC_BUILD  := build/pc
PC_CC     := gcc
PC_ARCH   := -m64 -fno-pie
# -DNON_MATCHING is deliberate, and it was briefly removed for the wrong
# reason. It activates the guarded drafts in ~25 files: attempts that are not
# byte-exact and were guarded so the MATCHING build would not use them.
#
# The port is not the matching build. docs/PC_PORT_ARCHITECTURE.md states the
# rule -- behaviour accuracy takes precedence over byte-for-byte fidelity in
# the port, while the N64 build stays byte-exact -- and a working non-matching
# implementation is strictly better here than a weak abort-on-call stub.
# Removing it cost the port scThreadMain, whose only C form is a draft, and the
# scheduler thread died on a stub instead of running.
#
# It was removed because one draft did not compile (func_80023990 in
# libn_audio.c referenced KAudioMgr fields that do not exist). That was one bad
# draft, not a reason to discard the mechanism; it has since been fixed and all
# 151 files compile with the define.
PC_DEFS   := -D_LANGUAGE_C -DTARGET_N64 -DPORT -DF3DEX_GBI_2 -DAVOID_UB -DNON_MATCHING
PC_INC    := -Iinclude -Iinclude/libc -Ilibreultra/include/2.0I -Ibuild \
             -Ibuild/include -Ibuild/assets -Isrc -I.
PC_CFLAGS := $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) $(PC_INC)

GAME_SRCS := $(wildcard src/*/*.c)
GAME_OBJS := $(patsubst %.c,$(PC_BUILD)/%.o,$(GAME_SRCS))

# ---------------------------------------------------------------- platform
#
# src/pc/ is the libultra replacement. It is picked up by the src/*/*.c
# wildcard above, so it needs no separate object list, but it does need a
# different include path -- see the rule near the bottom of this file.
#
# THREE BACKENDS NOW, and this Makefile builds only two of them.
#
#   pc_backend_null.c   headless. The default here.
#   pc_backend_sdl.c    PC_SDL=1. An SDL2 window with a streaming texture; it
#                       blits an N64 framebuffer and has no renderer.
#   pc_backend_lus.cpp  libultraship: window, Fast3D, input, audio. It is C++
#                       and cannot share an include path with the game's
#                       headers (see the comment at the top of that file), so
#                       it is compiled by tools/pc/build_lus_backend.sh and
#                       linked by tools/pc/link.sh, which is also what drops
#                       the other two objects. It is the DEFAULT for the
#                       binary; this Makefile only ever produces objects.
#
# So: `make -f Makefile.pc objs` for the measurement, `tools/pc/link.sh` for a
# binary. pc_backend_null.c and pc_backend_sdl.c are #ifdef'd against each
# other so exactly one of them contributes symbols either way.
PC_SDL     ?=
ifeq ($(PC_SDL),1)
PC_PLAT_DEFS := -DPC_SDL $(shell sdl2-config --cflags)
PC_PLAT_LIBS := $(shell sdl2-config --libs)
else
PC_PLAT_DEFS :=
PC_PLAT_LIBS :=
endif

# ------------------------------------------------- reused libultra sources
#
# libreultra/src holds real libultra C. The parts that touch no hardware are
# reused rather than rewritten -- rewriting guS2DInitBg or the NTSC VI
# register table by hand would only be an opportunity to get a constant wrong.
#
# They build into $(PC_BUILD)/src/libreultra/ so that tools/pc/gap.py and
# tools/pc/link.sh, which both glob build/pc/src/*/*.o, pick them up with no
# change.
LU_GU_SRCS := mtxcatf mtxutil normalize us2dex
LU_IO_SRCS := vimodentsclan1 vimodempallan1 vimodefpallan1
LU_AU_SRCS := cents2ratio copy
# n_synsetpan is the sibling of n_synsetvol and was simply omitted. It
# defines only n_alSynSetPan and calls __n_allocParam, which the
# decompilation already supplies, so there is no overlap of the kind
# documented below. The game has its own byte-exact copy of this function
# (func_8002CFE4 in src/main/libn_audio_2e.c) but it is stuck behind
# NON_MATCHING by a padding trap -- un-guarding it shortens that TU by 4
# bytes -- so the library copy is what links today.
LU_NA_SRCS := n_cspsetfxmix n_cspsetpriority n_event n_synsetvol n_synsetpan
#
# THREE MORE libreultra audio files would each supply one still-missing
# symbol, and all three are deliberately left out because they collide with
# the decompilation that already landed:
#
#   audio/seq.c          alSeqNextEvent    but also alSeqSetLoc,
#                                          alSeqGetTicks, alSeqNewMarker,
#                                          which src/main/libn_audio_2.c has
#   libnaudio/n_env.c    n_alEnvmixerPull  but also n_alEnvmixerParam
#   libnaudio/n_synthesizer.c
#                        n_alSynNew        but also _n_timeToSamples and
#                                          __n_allocParam
#
# Linking them gives "multiple definition" on the overlap. The granularity of
# reuse is the translation unit, and once a TU is half-decompiled the reusable
# half is no longer separable -- so these three symbols are cheaper to finish
# in the decompilation than to fight for here.


# libultra's printf engine, which the game's fatal_printf and osSyncPrintf go
# through. Reused rather than mapped onto the host's vsnprintf because the
# format string extensions are libultra's, not C89's.
LU_LC_SRCS := xprintf xldtob xlitob

LU_OBJS := $(addprefix $(PC_BUILD)/src/libreultra/gu_,$(addsuffix .o,$(LU_GU_SRCS))) \
           $(addprefix $(PC_BUILD)/src/libreultra/io_,$(addsuffix .o,$(LU_IO_SRCS))) \
           $(addprefix $(PC_BUILD)/src/libreultra/au_,$(addsuffix .o,$(LU_AU_SRCS))) \
           $(addprefix $(PC_BUILD)/src/libreultra/na_,$(addsuffix .o,$(LU_NA_SRCS))) \
           $(addprefix $(PC_BUILD)/src/libreultra/lc_,$(addsuffix .o,$(LU_LC_SRCS)))

# libreultra's sources want their own headers first (its <PR/os.h>, <mbi.h>,
# <libaudio.h>), which the game tree does not have.
# -include tools/pc/lu_lp64.h: libreultra's own <PR/ultratypes.h> typedefs u32
# as `unsigned long`, which is 8 bytes at -m64 and silently doubles every field
# in every struct it compiles. The shim claims that header's include guard and
# supplies LP64-correct types instead. Read its comment before removing it --
# the failure it prevents is wrong data, not a build error.
LU_INC := -include tools/pc/lu_lp64.h \
          -Ilibreultra/include/2.0I -Ilibreultra/include/2.0I/PR -Ilibreultra/src \
          -Ilibreultra/src/gu -Ilibreultra/src/io -Ilibreultra/src/audio \
          -Ilibreultra/src/libnaudio -Iinclude -I.

DATA_SRCS := $(wildcard $(PC_BUILD)/data/*.c)
DATA_OBJS := $(patsubst %.c,%.o,$(DATA_SRCS))

.PHONY: all objs data dataobjs defsyms gap link smoke smoke-deep lp64 clean
all: link

# The data translation has to run before its objects can be enumerated, so it
# is a separate invocation rather than a prerequisite.
data:
	@python3 tools/pc/gen_data.py

# datatodo.txt's absolute N64 addresses, the overlay bss bounds and the
# address-named orphans, all re-expressed against the translated C symbols and
# the port's own RAM spans. The link takes them as --defsym.
#
# THIS RUNS AFTER dataobjs AND THAT ORDERING IS LOAD-BEARING. gen_defsyms.py
# reads the still-undefined set out of build/pc/**/*.o to find the
# address-named symbols datatodo.txt does not list (D_800D723C and its kind),
# and to refuse to emit a --defsym for anything an object already defines --
# which would be `ld: multiple definition`, not a harmless duplicate. With no
# data objects to read it silently emits less, so `objs` sequences it last.
defsyms:
	@python3 tools/pc/gen_defsyms.py

objs: $(GAME_OBJS) $(LU_OBJS)
	@$(MAKE) -s -f Makefile.pc data
	@$(MAKE) -s -f Makefile.pc dataobjs
	@$(MAKE) -s -f Makefile.pc defsyms
	@echo "$(words $(GAME_OBJS)) game objects built, $(words $(LU_OBJS)) reused from libreultra"

dataobjs: $(DATA_OBJS)

$(PC_BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_CFLAGS) -c $< -o $@

# The platform layer needs the HOST libc headers, and include/libc/ shadows
# them with the four-declaration stubs the matching build uses (its stdio.h
# declares sprintf and nothing else; libreultra/include/2.0I/stdarg.h shadows
# gcc's, which breaks glibc's <stdio.h> at __gnuc_va_list). Both directories
# are therefore demoted with -idirafter: still searched, but after the system
# ones, so <stdio.h> is real and <PR/os_pfs.h> still resolves.
PC_PLAT_INC := -Iinclude -Isrc -I. \
               -idirafter libreultra/include/2.0I -idirafter include/libc \
               -idirafter build -idirafter build/include -idirafter build/assets

$(PC_BUILD)/src/pc/%.o: src/pc/%.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) \
	    $(PC_PLAT_DEFS) $(PC_PLAT_INC) -c $< -o $@

$(PC_BUILD)/src/libreultra/gu_%.o: libreultra/src/gu/%.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) $(LU_INC) -c $< -o $@

$(PC_BUILD)/src/libreultra/io_%.o: libreultra/src/io/%.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) $(LU_INC) -c $< -o $@

$(PC_BUILD)/src/libreultra/au_%.o: libreultra/src/audio/%.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) $(LU_INC) -c $< -o $@

$(PC_BUILD)/src/libreultra/na_%.o: libreultra/src/libnaudio/%.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) $(LU_INC) -c $< -o $@

# -include stddef.h: libreultra's own <string.h> uses size_t without ever
# defining it, which the IDO build got away with and gcc does not.
$(PC_BUILD)/src/libreultra/lc_%.o: libreultra/src/libc/%.c
	@mkdir -p $(dir $@)
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -fsigned-char -g -O1 -w $(PC_DEFS) \
	    -include stddef.h -Ilibreultra/src/libc $(LU_INC) -c $< -o $@

$(PC_BUILD)/data/%.o: $(PC_BUILD)/data/%.c
	@$(PC_CC) $(PC_ARCH) -std=gnu90 -w -Isrc -c $< -o $@

gap: objs
	@python3 tools/pc/gap.py

# The binary, or the reason there is not one yet. See the note at the top of
# this file about the exit status, and tools/pc/link.py's header for why it
# refuses to stub anything.
link: objs
	@python3 tools/pc/link.py

# How far the binary gets, as one line, repeatably.
#
# `gap` measures what the port still OWES; this measures what it DOES. Since
# the link closed, the second number is the one that moves, and it needs a
# target so that "it boots further now" is a check and not an anecdote. The
# run is headless, accelerated (see KIRBY_PC_TIMESCALE in src/pc/os_time.c),
# bounded by a timeout, and it fails if the port stops short of the stage
# tools/pc/smoke.py records as the high-water mark.
#
# Deliberately NOT dependent on `link`: the commonest use is to re-run the
# binary that is already there, and rebuilding 150 objects first turns a
# five-second check into a two-minute one. `make -f Makefile.pc && make -f
# Makefile.pc smoke` when the sources changed.
smoke:
	@python3 tools/pc/smoke.py $(SMOKEFLAGS)

# The same measurement with a controller attached.
#
# `smoke` measures the boot and stops where an unattended run has to stop: the
# attract loop never exits without a START press. This one supplies the press
# (src/pc/pc_input_script.c, KIRBY_PC_INPUT=autostart) and keeps going into
# the file select, the world map and the first cutscene, which is where the
# crashes worth finding now are. Slower and it needs the ROM, so it is a
# separate target rather than the default.
smoke-deep:
	@python3 tools/pc/smoke.py --deep $(SMOKEFLAGS)

# Where the port will crash NEXT.
#
# -w above silences every warning, and the one class it should never have
# silenced is a pointer changing width: that is what actually stops this port,
# and it stops it eight seconds later in a function that is not the one at
# fault. This re-runs the same compile with only the four pointer-width
# diagnostics on and turns them into a worklist grouped by the declaration
# that is wrong. It compiles nothing into build/pc, so it cannot disturb a
# build or another lane. See the header of tools/pc/lp64_audit.py.
lp64:
	@python3 tools/pc/lp64_audit.py $(LP64FLAGS)

clean:
	@rm -rf $(PC_BUILD)
