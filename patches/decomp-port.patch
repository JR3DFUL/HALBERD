+    pc_lvl_region(h[4], 4);  /* Normals: f32 quads */
+    pc_lvl_region(h[6], 2);  /* Triangle_Cells: u16 */
+    pc_lvl_region(h[8], 2);  /* Triangle_Norm_Cells: u16 x4 each */
