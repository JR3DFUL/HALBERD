+#define n_aResample(pkt, s, f, p, i, o)                                 \
+{                                                                       \
+    Acmd *_a = (Acmd *)pkt;                                             \
+                                                                        \
+    _a->words.w0 = (_SHIFTL(A_RESAMPLE, 24, 8) | _SHIFTL(s, 0, 24));    \
+    _a->words.w1 = (_SHIFTL(f, 30, 2) | _SHIFTL(p, 14, 16) |            \
+                    _SHIFTL(i, 2, 12) | _SHIFTL(o, 0, 2));              \
