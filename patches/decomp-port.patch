+
+#define n_aLoadBuffer(pkt, c, d, s)                                     \
+{                                                                       \
+    Acmd *_a = (Acmd *)pkt;                                             \
+                                                                        \
+    _a->words.w0 = (_SHIFTL(A_LOADBUFF, 24, 8) | _SHIFTL(c, 12, 12)|    \
+                    _SHIFTL(d, 0, 12));                                 \
+    _a->words.w1 = (unsigned int)(s);                                   \
+}
+
+#define n_aLoadADPCM(pkt, c, d)                                         \
+{                                                                       \
+    Acmd *_a = (Acmd *)pkt;                                             \
+                                                                        \
