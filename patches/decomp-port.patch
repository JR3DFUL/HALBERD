+
+#define n_aPoleFilter(pkt, f, g, t, s)                                  \
+{                                                                       \
+    Acmd *_a = (Acmd *)pkt;                                             \
+                                                                        \
+    _a->words.w0 = (_SHIFTL(A_POLEF, 24, 8) | _SHIFTL(f, 16, 8) |       \
