 void GfxRenderingAPIOGL::SetPerDrawUniforms() {
+    /* A native-ROM list can reach its first draw before any shader program has
+     * been bound (measured: first S2DEX texrect of the boot frame). Skip the
+     * uniforms rather than dereferencing null; the next combiner state change
+     * binds a program through the normal lookup path. */
+    if (mCurrentShaderProgram == nullptr) {
+        return;
+    }
     glUniform1f(mCurrentShaderProgram->prim_depth_location, mCurrentPrimDepth);
 
     if (mCurrentShaderProgram->usedTextures[0] || mCurrentShaderProgram->usedTextures[1]) {
+        /* Same first-draw hazard as above: texture ids may not have been
+         * selected yet, and indexing the vector with a stale id faults. */
+        if (mCurrentTextureIds[0] < 0 || (size_t)mCurrentTextureIds[0] >= textures.size() ||
+            mCurrentTextureIds[1] < 0 || (size_t)mCurrentTextureIds[1] >= textures.size()) {
+            return;
+        }
         GLint filtering[2] = { textures[mCurrentTextureIds[0]].filtering, textures[mCurrentTextureIds[1]].filtering };
         glUniform1iv(mCurrentShaderProgram->texture_filtering_location, 2, filtering);
 
