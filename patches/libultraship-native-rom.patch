+// S2DEX G_OBJ_LOADTXTR (gSPObjLoadTxtr).
+//
+// The game emits uObjTxtr structures in the N64 wire layout (24 bytes, see gs2dex.h): the image field is a single
+// 32-bit word holding a plain host address below 4GB (not segmented). The F3DuObjTxtr mirror in lus_gbi.h declares
+// image as a native 64-bit pointer, which shifts every following field on 64-bit hosts, so the structure is read here
+// through a wire-accurate view instead.
+struct F3DuObjTxtrWire {
+    uint32_t type;  /* G_OBJLT_TXTRBLOCK / G_OBJLT_TXTRTILE / G_OBJLT_TLUT */
+    uint32_t image; /* host address of source data (32-bit on the wire) */
+    uint16_t w0;    /* BLOCK: tmem    TILE: tmem     TLUT: phead */
+    uint16_t w1;    /* BLOCK: tsize   TILE: twidth   TLUT: pnum  */
+    uint16_t w2;    /* BLOCK: tline   TILE: theight  TLUT: zero  */
+    uint16_t sid;   /* STATE ID */
+    uint32_t flag;  /* STATE flag */
+    uint32_t mask;  /* STATE mask */
+};
+
+void Interpreter::Gfxs2dexObjLoadTxtr(F3DuObjTxtr* txtr) {
+    const F3DuObjTxtrWire* wire = reinterpret_cast<const F3DuObjTxtrWire*>(txtr);
+    uintptr_t data = (uintptr_t)wire->image;
+
+    uint32_t texFlags = 0;
+    RawTexMetadata rawTexMetadata = {};
+
+    // Same image resolution as the uObjBg paths above: OTR resources are resolved to their pixel data, anything else
+    // is treated as a raw host pointer to texels.
+    if ((bool)gfx_check_image_signature((char*)data)) {
+        std::shared_ptr<Fast::Texture> tex =
+            std::static_pointer_cast<Fast::Texture>(mResourceManager->LoadResourceProcess((char*)data));
+        texFlags = tex->Flags;
+        rawTexMetadata.width = tex->Width;
+        rawTexMetadata.height = tex->Height;
+        rawTexMetadata.h_byte_scale = tex->HByteScale;
+        rawTexMetadata.v_pixel_scale = tex->VPixelScale;
+        rawTexMetadata.type = tex->Type;
+        rawTexMetadata.resource = tex;
+        data = (uintptr_t) reinterpret_cast<char*>(tex->ImageData);
+    }
+
+    switch (wire->type) {
+        case G_OBJLT_TLUT: {
+            // Equivalent of gDPLoadTLUT: phead is the TMEM word address (256..511 = standard palette area), pnum is
+            // entry count - 1. Routing through GfxDpSetTextureImage/GfxDpSetTile/GfxDpLoadTlut reuses the exact
+            // palette staging logic (palette_staging/palettes/palette_dram_addr) of the RDP G_LOADTLUT path.
+            uint16_t phead = wire->w0;
+            uint16_t pnum = wire->w1;
+            GfxDpSetTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 1, nullptr, texFlags, rawTexMetadata, (void*)data);
+            GfxDpSetTile(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, phead, G_TX_LOADTILE, 0, 0, 0, 0, 0, 0, 0);
+            GfxDpLoadTlut(G_TX_LOADTILE, pnum);
+            break;
+        }
+        case G_OBJLT_TXTRBLOCK: {
+            // tsize = TMEM 64-bit words to load - 1 => byte count = (tsize + 1) * 8. The load is performed as a plain
+            // block of 16-bit texels so GfxDpLoadBlock records texture_to_load/loaded_texture addr + size and marks
+            // textures_changed; the real texel format/size of the render tile comes from the tile setup accompanying
+            // the following sprite draw, exactly like the uObjBg block loads above.
+            uint16_t tmem = wire->w0;
+            uint32_t texels16 = ((uint32_t)wire->w1 + 1) << 2; // (tsize + 1) * 8 bytes, 2 bytes per 16b texel
+            GfxDpSetTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 1, nullptr, texFlags, rawTexMetadata, (void*)data);
+            GfxDpSetTile(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, tmem, G_TX_LOADTILE, 0, 0, 0, 0, 0, 0, 0);
+            GfxDpLoadBlock(G_TX_LOADTILE, 0, 0, texels16 - 1, 0);
+            break;
+        }
+        case G_OBJLT_TXTRTILE: {
+            // twidth = (TMEM words per line << 2) - 1, theight = (texture rows << 2) - 1. Deferred: true
+            // sub-rectangle tile loads where the DRAM stride differs from the TMEM line width; the load is treated as
+            // one contiguous block, which is equivalent for the full-width tile loads the game emits.
+            uint16_t tmem = wire->w0;
+            uint32_t lineWords = ((uint32_t)wire->w1 + 1) >> 2;
+            uint32_t rows = ((uint32_t)wire->w2 + 1) >> 2;
+            uint32_t sizeBytes = lineWords * 8 * rows;
+            GfxDpSetTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 1, nullptr, texFlags, rawTexMetadata, (void*)data);
+            GfxDpSetTile(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, tmem, G_TX_LOADTILE, 0, 0, 0, 0, 0, 0, 0);
+            GfxDpLoadBlock(G_TX_LOADTILE, 0, 0, (sizeBytes >> 1) - 1, 0);
+            break;
+        }
+        default:
+            // Unknown load type; nothing sensible to do.
+            break;
+    }
+}
