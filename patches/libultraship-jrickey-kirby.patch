+// Kirby port: is ptr inside the main executable's own image (its data or
+// bss)? The non-PIE game's arena and statics live there, below 256 MB. The
+// image's extent is read once from the program headers, so the per-command
+// test is two compares (dladdr walks the symbol table on every call).
+#ifndef _WIN32
+static int gfxMainImageExtentCb(struct dl_phdr_info* info, size_t, void* data) {
+    uintptr_t* ext = static_cast<uintptr_t*>(data);
+    for (int i = 0; i < info->dlpi_phnum; i++) {
+        const ElfW(Phdr)& ph = info->dlpi_phdr[i];
+        if (ph.p_type != PT_LOAD) {
+            continue;
+        }
+        uintptr_t lo = info->dlpi_addr + ph.p_vaddr;
+        uintptr_t hi = lo + ph.p_memsz;
+        if (ext[0] == 0 || lo < ext[0]) {
+            ext[0] = lo;
+        }
+        if (hi > ext[1]) {
+            ext[1] = hi;
+        }
+    }
+    return 1; // the first object reported is the main program
+}
+#endif
+
+bool gfxPointerInMainImage(const void* ptr) {
+    if (ptr == nullptr) {
+        return false;
+    }
+#ifdef _WIN32
+    HMODULE mod = nullptr;
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           reinterpret_cast<LPCSTR>(ptr), &mod) == 0) {
+        return false;
+    }
+    return mod != nullptr && mod == GetModuleHandleA(nullptr);
+#else
+    static uintptr_t sExtent[2] = { 0, 0 };
+    static bool sInit = false;
+    if (!sInit) {
+        sInit = true;
+        dl_iterate_phdr(gfxMainImageExtentCb, sExtent);
+    }
+    uintptr_t p = reinterpret_cast<uintptr_t>(ptr);
+    return p >= sExtent[0] && p < sExtent[1];
+#endif
+}
