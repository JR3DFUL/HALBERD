+// PORT (Kirby 64): G_OBJ_LOADTXTR (S2DEX). w1 is a host pointer to a uObjTxtr
+// struct in native layout (no SegAddr, matching the BG handlers' convention).
+// TLUT loads reuse the RDP palette plumbing by mirroring the gDPLoadTLUT macro
+// expansion (SETTIMG RGBA16 + SETTILE tmem=phead on LOADTILE + LOADTLUT), so
+// palette_staging/palettes[] logic in GfxDpLoadTlut is shared, not duplicated.
+// Block/tile loads stage texture_to_load via SETTIMG + SETTILE(tmem) +
+// LOADBLOCK, with the texel count derived from the wire fields the same way
+// the S2DEX spec computes them (GS_TB_TSIZE / GS_TT_TWIDTH / GS_TT_THEIGHT),
+// expressed as 16b texels (which is what tsize encodes: tmem 64-bit words).
+bool gfx_obj_loadtxtr_handler_s2dex(F3DGfx** cmd0) {
+    Interpreter* gfx = mInstance.lock().get();
+    F3DGfx* cmd = *(cmd0);
+
+    F3DuObjTxtr* txtr = (F3DuObjTxtr*)cmd->words.w1; // not gfx->SegAddr here, matching the bg handlers
+    if (txtr == nullptr) {
+        return false;
+    }
+
+    switch (txtr->block.type) {
+        case G_OBJLT_TLUT:
+            // phead is the palette-area TMEM word address (256..511); pnum is
+            // the high entry index (entry count - 1), exactly LOADTLUT's arg.
+            gfx->GfxDpSetTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, nullptr, 0, {}, (void*)txtr->tlut.image);
+            gfx->GfxDpSetTile(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, txtr->tlut.phead, G_TX_LOADTILE, 0, 0, 0, 0, 0, 0, 0);
+            gfx->GfxDpLoadTlut(G_TX_LOADTILE, txtr->tlut.pnum);
+            break;
+        case G_OBJLT_TXTRBLOCK: {
+            // tsize = (tmem 64-bit words) - 1 (GS_TB_TSIZE); one word holds
+            // four 16b texels, so lrs = words * 4 - 1. tline is the DXT value.
+            uint32_t words = (uint32_t)txtr->block.tsize + 1;
+            gfx->GfxDpSetTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, nullptr, 0, {}, (void*)txtr->block.image);
+            gfx->GfxDpSetTile(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, txtr->block.tmem, G_TX_LOADTILE, 0, 0, 0, 0, 0, 0, 0);
+            gfx->GfxDpLoadBlock(G_TX_LOADTILE, 0, 0, (words << 2) - 1, txtr->block.tline);
+            break;
+        }
+        case G_OBJLT_TXTRTILE: {
+            // twidth = (line words << 2) - 1 (GS_TT_TWIDTH) and
+            // theight = (rows << 2) - 1 (GS_TT_THEIGHT), so the total load is
+            // line_words * rows words = (twidth + 1) * ((theight + 1) >> 2)
+            // 16b texels (4 texels per word cancels the twidth <<2).
+            uint32_t texels16 = ((uint32_t)txtr->tile.twidth + 1) * (((uint32_t)txtr->tile.theight + 1) >> 2);
+            if (texels16 == 0) {
+                break;
+            }
+            gfx->GfxDpSetTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, nullptr, 0, {}, (void*)txtr->tile.image);
+            gfx->GfxDpSetTile(G_IM_FMT_RGBA, G_IM_SIZ_16b, 0, txtr->tile.tmem, G_TX_LOADTILE, 0, 0, 0, 0, 0, 0, 0);
+            gfx->GfxDpLoadBlock(G_TX_LOADTILE, 0, 0, texels16 - 1, 0);
+            break;
+        }
+        default:
+            SPDLOG_WARN("G_OBJ_LOADTXTR: unknown uObjTxtr type 0x{:08X}", (uint32_t)txtr->block.type);
+            break;
+    }
+    return false;
+}
