+// KIRBY_PC_DRAWLOG texture-upload census: name, source addr, size, and how
+// much of the decoded RGBA output is non-black / non-transparent.
+static void KirbyDumpUpload(const char* what, const uint8_t* addr, const uint8_t* buf, uint32_t w, uint32_t h) {
+    extern bool gKirbyPcDrawLogActive();
+    static const bool census = getenv("KIRBY_PC_TEXCENSUS") != nullptr;
+    if (!gKirbyPcDrawLogActive() && !census) {
+        return;
+    }
+    uint32_t n = w * h, nz = 0, anz = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        if (buf[4 * i] | buf[4 * i + 1] | buf[4 * i + 2]) {
+            nz++;
+        }
+        if (buf[4 * i + 3]) {
+            anz++;
+        }
+    }
+    fprintf(stderr, "[dlog tex %s] addr=%p %ux%u rgb_nz=%.2f a_nz=%.2f src8=", what, (const void*)addr, w, h,
+            n ? (double)nz / n : 0.0, n ? (double)anz / n : 0.0);
+    for (int i = 0; i < 8; i++) {
+        fprintf(stderr, "%02x", addr[i]);
+    }
+    fprintf(stderr, "\n");
+}
